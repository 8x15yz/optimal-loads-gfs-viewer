# Add to existing ingest .env_runtime; do NOT replace credentials or other settings.
# Add MONGO_PACKAGES_COL and SRP_URL_* / SRP_VERIFY_OBJECT to API container environment too.
MONGO_PACKAGES_COL=forecast_packages
# Empty means reuse S3_BUCKET / AWS_REGION.
SRP_S3_BUCKET=
SRP_S3_REGION=
SRP_S3_PREFIX=noaa/gfs/fc
SRP_URL_EXPIRES_SECONDS=3600
SRP_VERIFY_OBJECT=false
SRP_MAX_MINUTES=70
